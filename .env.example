# Superusuário administrativo da instância Postgres (não é usado pelas Apis) — DBeaver, migrations manuais, etc.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Senha da role "auth_service", dona do banco ouroboros_auth — é a credencial que a Api do Auth usa
# na connection string (ver docs/0002 - Setup do Banco de Dados Local.md).
AUTH_DB_PASSWORD=change-me-too

# Opcional, só usado pela stack em container (docker compose --profile apps).
# Endereço público do Api Gateway, usado nos links enviados por e-mail.
# Se não definido, vale http://localhost:5082 — ver docs/0006 - Rodando a Stack em Containers.md.
# PUBLIC_BASE_URL=http://localhost:5082
