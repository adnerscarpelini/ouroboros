# Copie para ".env" na raiz do monorepo e preencha os valores reais.
# ".env" nunca e versionado (ver .gitignore).

# Porta do host mapeada para o SQL Server do container (1433 dentro do container).
SQLSERVER_PORT=1433

# Senha do login "sa", usada so pra administracao da instancia (criar bancos/logins de cada servico via
# docker/sqlserver/init/*.sh). Nenhuma aplicacao usa essas credenciais pra se conectar ao proprio banco.
# O SQL Server exige senha forte: minimo 8 caracteres com maiuscula, minuscula e numero.
SQLSERVER_SA_PASSWORD=Troque-Esta-Senha-1

# Banco e papeis do auth-service (ver docker/sqlserver/init/01-create-auth-db.sh).
AUTH_DB_NAME=ouroboros_auth

# auth_migrator: dono do schema (db_owner), faz o DDL. So o comando "migrate" (servico auth-migrate) usa este papel.
AUTH_MIGRATOR_USER=auth_migrator
AUTH_MIGRATOR_PASSWORD=Troque-Esta-Senha-2

# auth_service: so DML (SELECT, INSERT, UPDATE, DELETE) no schema auth. E o papel que a API usa.
# As senhas dos dois papeis passam na politica do SQL Server (CHECK_POLICY = ON) e devem ser diferentes.
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=Troque-Esta-Senha-1

# Portas do host mapeadas para o Seq (UI web na 80 do container, ingestao de logs na 5341).
SEQ_UI_PORT=8081
SEQ_INGESTION_PORT=5341

# Senha do usuario admin criado no primeiro start do Seq (login: admin).
SEQ_ADMIN_PASSWORD=troque-esta-senha

# Chave de assinatura dos JWT emitidos pelo auth-service: RSA de pelo menos 2048 bits (RS256), em um arquivo PEM fora do git.
# So o auth-service tem a privada; os outros servicos validam com a publica, em /.well-known/jwks.json.
# Gere uma chave por ambiente (a pasta secrets/ e o *.pem estao no .gitignore):
#   mkdir -p secrets
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/auth-jwt-private-key.pem
#   chmod 644 secrets/auth-jwt-private-key.pem   # o container roda sem root (usuario "app") e precisa ler o arquivo
# Identificador da chave (o "kid" do header de todo JWT). Troque a cada chave nova (ver docs/auth/0002 - Configuracao JWT.md).
AUTH_JWT_KEY_ID=auth-dev-1
# Caminho do PEM no host, montado somente leitura no container.
AUTH_JWT_PRIVATE_KEY_FILE=./secrets/auth-jwt-private-key.pem
