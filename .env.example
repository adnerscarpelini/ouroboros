# Copie para ".env" na raiz do monorepo e preencha os valores reais.
# ".env" nunca e versionado (ver .gitignore).

# Porta do host mapeada para o SQL Server do container (1433 dentro do container).
SQLSERVER_PORT=1433

# Senha do login "sa", usada so pra administracao da instancia (criar bancos/logins de cada servico via
# docker/sqlserver/init/*.sh). Nenhuma aplicacao usa essas credenciais pra se conectar ao proprio banco.
# O SQL Server exige senha forte: minimo 8 caracteres com maiuscula, minuscula e numero.
SQLSERVER_SA_PASSWORD=Troque-Esta-Senha-1

# Banco e login do auth-service (ver docker/sqlserver/init/01-create-auth-db.sh).
AUTH_DB_NAME=ouroboros_auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=Troque-Esta-Senha-1

# Portas do host mapeadas para o Seq (UI web na 80 do container, ingestao de logs na 5341).
SEQ_UI_PORT=8081
SEQ_INGESTION_PORT=5341

# Senha do usuario admin criado no primeiro start do Seq (login: admin).
SEQ_ADMIN_PASSWORD=troque-esta-senha

# Chave de assinatura dos JWT emitidos pelo auth-service (HMAC-SHA256, minimo 32 caracteres).
# Gere uma chave aleatoria por ambiente, ex.: openssl rand -base64 48
AUTH_JWT_SIGNING_KEY=troque-esta-chave-por-uma-com-pelo-menos-32-caracteres
