# Copie para ".env" na raiz do monorepo e preencha os valores reais.
# ".env" nunca e versionado (ver .gitignore).

# Porta do host mapeada para o Postgres do container (5432 dentro do container).
POSTGRES_PORT=5432

# Superusuario do Postgres, usado so pra administracao da instancia
# (criar bancos/roles de cada servico via docker/postgres/init/*.sh).
# Nenhuma aplicacao usa essas credenciais pra se conectar ao proprio banco.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=troque-esta-senha

# Banco e role do auth-service (ver docker/postgres/init/01-create-auth-db.sh).
AUTH_DB_NAME=ouroboros_auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=troque-esta-senha

# Portas do host mapeadas para o Seq (UI web na 80 do container, ingestao de logs na 5341).
SEQ_UI_PORT=8081
SEQ_INGESTION_PORT=5341

# Senha do usuario admin criado no primeiro start do Seq (login: admin).
SEQ_ADMIN_PASSWORD=troque-esta-senha
