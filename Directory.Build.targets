<Project>

  <!--
    Roda os testes automaticamente após o build bem-sucedido da Api do Auth (projeto de entrada da aplicação).
    A variável OUROBOROS_SKIP_AUTOTEST evita recursão: o "dotnet test" disparado aqui builda a solution
    novamente (incluindo a própria Api), o que sem essa guarda acionaria este target de novo.

    Exclui a categoria Integration deste filtro: os testes de integração (repositórios, UnitOfWork,
    migrator) sobem um Postgres efêmero via Testcontainers e exigem Docker rodando. Rodar isso a
    cada build tornaria o build lento e dependente de Docker sempre ligado. Rode-os à parte com o
    comando descrito em CLAUDE.md, seção "Comandos" (dotnet test filtrando Category=Integration).
  -->
  <Target Name="RunTestsAfterBuild"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'Ouroboros.AuthService.Api' and '$(OUROBOROS_SKIP_AUTOTEST)' != 'true'">
    <Exec Command="dotnet test &quot;$(MSBuildThisFileDirectory)Ouroboros.slnx&quot; --filter &quot;Category!=Integration&quot; --nologo"
          EnvironmentVariables="OUROBOROS_SKIP_AUTOTEST=true" />
  </Target>

</Project>
