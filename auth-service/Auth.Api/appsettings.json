{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8082"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "ouroboros-auth",
    "Audience": "ouroboros",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Seq": {
    "ServerUrl": ""
  },
  "RateLimiting": {
    "password-reset-request": { "PermitLimit": 5, "Window": "00:15:00" },
    "password-reset-confirm": { "PermitLimit": 10, "Window": "00:15:00" },
    "user-register": { "PermitLimit": 5, "Window": "00:15:00" },
    "user-delete": { "PermitLimit": 5, "Window": "00:15:00" },
    "password-change": { "PermitLimit": 5, "Window": "00:15:00" },
    "auth-login": { "PermitLimit": 20, "Window": "00:15:00" },
    "auth-refresh": { "PermitLimit": 60, "Window": "00:15:00" },
    "email-confirm": { "PermitLimit": 10, "Window": "00:15:00" }
  },
  "TokenCleanup": {
    "Enabled": true,
    "Interval": "01:00:00",
    "Retention": "30.00:00:00"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
