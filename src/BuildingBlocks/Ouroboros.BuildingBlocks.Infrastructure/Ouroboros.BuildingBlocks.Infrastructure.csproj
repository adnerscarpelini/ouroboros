<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ouroboros.BuildingBlocks.Application\Ouroboros.BuildingBlocks.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL fica só pelos tipos base do EF Core (DbContext, ModelBuilder)
